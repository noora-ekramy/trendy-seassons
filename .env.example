# Neon Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Neon S3-compatible image storage
# Use S3_* names on Netlify (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION are reserved there)
S3_ENDPOINT_URL="https://YOUR-ENDPOINT.storage.REGION.aws.neon.tech"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_REGION="your-region"
S3_BUCKET="your-bucket-name"

# Admin panel
ADMIN_PASSWORD=your-admin-password
ADMIN_SECRET=your-admin-secret

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=20XXXXXXXXXX

# AI chat (optional)
COHERE_API_KEY=
