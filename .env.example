# Neon Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Neon S3-compatible image storage
AWS_ENDPOINT_URL_S3="https://YOUR-ENDPOINT.storage.REGION.aws.neon.tech"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION="us-east-2"
S3_BUCKET="trendy-seasons"

# Admin panel
ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-me-too

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=201000000000

# AI chat (optional)
COHERE_API_KEY=
