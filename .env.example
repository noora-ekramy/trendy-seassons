# Neon Postgres
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Neon S3-compatible image storage
# Use S3_* names on Netlify (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION are reserved there)
S3_ENDPOINT_URL="https://YOUR-ENDPOINT.storage.REGION.aws.neon.tech"
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION="us-east-2"
S3_BUCKET="trendy-seasons"

# Admin panel
ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-me-too

# WhatsApp
NEXT_PUBLIC_WHATSAPP_NUMBER=201000000000

# AI chat (optional)
COHERE_API_KEY=
